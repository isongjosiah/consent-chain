{
  "name": "@consentchain/contracts",
  "version": "0.1.0",
  "description": "ConsentChain Solidity contracts: ConsentRegistry, UnlearningOracle, FLGatekeeper.",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol' && eslint . --ext .ts",
    "format": "prettier --write 'contracts/**/*.sol' '**/*.ts'",
    "deploy:purechain": "hardhat run scripts/deploy.ts --network purechain",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "smoke:purechain": "hardhat run scripts/smoke-test.ts --network purechain",
    "smoke:amoy": "hardhat run scripts/smoke-test.ts --network amoy",
    "smoke:localhost": "hardhat run scripts/smoke-test.ts --network localhost",
    "measure-gas:amoy": "hardhat run scripts/measure-gas.ts --network amoy",
    "measure-latency": "hardhat run scripts/measure-latency.ts",
    "scalability-bench": "hardhat run scripts/scalability-bench.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.6",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-verify": "^2.0.5",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "ethers": "^6.11.1",
    "hardhat": "^2.22.2",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.5.4",
    "solidity-coverage": "^0.8.11",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "~5.0.2"
  }
}
