# ConsentChain environment template.
# Copy to .env and fill real values. Never commit .env.

# ---- PureChain (primary, gas-free, PoA²) ----
PURECHAIN_RPC_URL=
PURECHAIN_CHAIN_ID=
PURECHAIN_DEPLOYER_PRIVATE_KEY=

# ---- Polygon Amoy (comparison baseline) ----
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
AMOY_CHAIN_ID=80002
AMOY_DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# ---- Verifier Committee (5 keys for 3-of-5 ECDSA multi-sig) ----
VC_VERIFIER_1_PRIVATE_KEY=
VC_VERIFIER_2_PRIVATE_KEY=
VC_VERIFIER_3_PRIVATE_KEY=
VC_VERIFIER_4_PRIVATE_KEY=
VC_VERIFIER_5_PRIVATE_KEY=

# ---- Gas reporter (set COINMARKETCAP_API_KEY for USD conversions in gas-report.txt) ----
COINMARKETCAP_API_KEY=
REPORT_GAS=false

# ---- FL pipeline ----
FL_DATA_ROOT=fl/datasets/raw
FL_RESULTS_ROOT=results
RANDOM_SEED=42

# ---- Web3 endpoint used by the FL ConsentGate (defaults to PureChain) ----
CONSENT_GATE_RPC_URL=
CONSENT_REGISTRY_ADDRESS=
UNLEARNING_ORACLE_ADDRESS=
FL_GATEKEEPER_ADDRESS=
